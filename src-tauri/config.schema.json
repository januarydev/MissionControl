{
  "$schema":"https://json-schema.org/draft-07/schema#",
  "properties": {
    "base_rate_hz": {
      "description": "Simulation base step rate, hz",
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "frontend_update_rate_hz": {
      "description": "Frontend data update rate, hz",
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "initial_time": {
      "description": "Simulation starting time/date (restricted to J2000 so no dates before Jan 1 2000 @ noon)",
      "type": "object",
      "properties": {
        "year": {
          "description": "CE year, must be 2000 or later",
          "type": "integer",
          "minimum": 2000,
          "maximum": 2150
        },
        "month": {
          "description": "Month of year, 1-12",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "description": "Day of month, will not restrict you to legal days (i.e., 30th of Feb will not be caught), so be careful!",
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "hour": {
          "description": "Hour of day, 24hour-based (0-23)",
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "description": "Minute of hour, 0-based",
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "second": {
          "description": "Second of minute, 0-based",
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 60
        }
      },
      "required": [
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "second"
      ]
    },
    "bodies": {
      "description": "Array of bodies to include in simulation EXCLUDING EARTH (always included by default)",
      "type":"array",
      "minItems": 1,
      "items": {
        "type":"object",
        "properties": {
          "name": {
            "description": "Body name",
            "type": "string"
          },
          "mass_kg": {
            "description": "Body mass, kg",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "position_eci_km": {
            "description": "Position of the body at simulation start in J2000 ECI, km",
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number"}
          },
          "velocity_eci_km_s": {
            "description": "Velocity of the body at simulation start in J2000 ECI, km/s",
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number"}
          }
        },
        "required": [
          "name",
          "mass_kg",
          "position_eci_km",
          "velocity_eci_km_s"
        ]
      }
    }
  },
  "required": [
    "base_rate_hz",
    "frontend_update_rate_hz",
    "initial_time",
    "bodies"
  ]
}
