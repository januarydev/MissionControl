{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "base_rate_hz": {
      "description": "Simulation base step rate, hz",
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "frontend_update_rate_hz": {
      "description": "Frontend data update rate, hz",
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "initial_time": {
      "description": "Simulation starting time/date (restricted to J2000 so no dates before Jan 1 2000 @ noon)",
      "type": "object",
      "properties": {
        "year": {
          "description": "CE year, must be 2000 or later",
          "type": "integer",
          "minimum": 2000,
          "maximum": 2150
        },
        "month": {
          "description": "Month of year, 1-12",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "description": "Day of month, will not restrict you to legal days (i.e., 30th of Feb will not be caught), so be careful!",
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "hour": {
          "description": "Hour of day, 24hour-based (0-23)",
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "description": "Minute of hour, 0-based",
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "second": {
          "description": "Second of minute, 0-based",
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 60
        }
      },
      "required": [
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "second"
      ]
    },
    "unfocused_bodies": {
      "description": "Array of bodies to include in background simulation EXCLUDING EARTH (always included by default)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/body"
      }
    },
    "focused_body": {
      "description": "Description of the body that can be controlled with commands and is focused for telemetry.",
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/body/properties/name"
        },
        "mass_kg": {
          "$ref": "#/$defs/body/properties/mass_kg"
        },
        "position_eci_km": {
          "$ref": "#/$defs/body/properties/position_eci_km"
        },
        "velocity_eci_km_s": {
          "$ref": "#/$defs/body/properties/velocity_eci_km_s"
        },
        "perturbation_stats": {
          "$ref": "#/$defs/body/properties/perturbation_stats"
        },
        "q_inertial_to_body": {
          "description": "Initial (normalized) quaternion from inertial frame to body attitude forward direction in [x, y, z, w] order.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "inertia_kg_m2": {
          "description": "Moments of (row-major) inertia tensor relative to body frame with origin at center of mass, kgm^2.",
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "name",
        "mass_kg",
        "position_eci_km",
        "velocity_eci_km_s",
        "perturbation_stats",
        "q_inertial_to_body",
        "inertia_kg_m2"
      ]
    }
  },
  "required": [
    "base_rate_hz",
    "frontend_update_rate_hz",
    "initial_time",
    "unfocused_bodies",
    "focused_body"
  ],
  "$defs": {
    "body": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Body name",
          "type": "string"
        },
        "mass_kg": {
          "description": "Body mass, kg",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "position_eci_km": {
          "description": "Position of the body at simulation start in J2000 ECI, km",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "velocity_eci_km_s": {
          "description": "Velocity of the body at simulation start in J2000 ECI, km/s",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "perturbation_stats": {
          "description": "Optional parameters for perturbation models (will not include perturbation modelling for body if not present).",
          "type": "object",
          "properties": {
            "aero_drag_area_m2": {
              "description": "Effective 'cannonball' model surface area for aerodynamic drag perturbation, m^2.",
              "type": "number",
              "minimum": 0
            },
            "aero_drag_coef": {
              "description": "Dimensionless coefficient of drag for aerodynamic drag perturbation.",
              "type": "number",
              "minimum": 0
            },
            "solar_rad_pres_area_m2": {
              "description": "Effective 'cannonball' model of surface area for solar radiation pressure perturbation, m^2",
              "type": "number",
              "minimum": 0
            },
            "solar_rad_pres_coef": {
              "description": "Dimensionless coefficient of absorption for solar radiation pressure perturbation.",
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "aero_drag_area_m2",
            "aero_drag_coef",
            "solar_rad_pres_area_m2",
            "solar_rad_pres_coef"
          ]
        }
      },
      "required": [
        "name",
        "mass_kg",
        "position_eci_km",
        "velocity_eci_km_s"
      ]
    }
  }
}
